  "patches": [
    {
      "id": "explicit_native_completion_callbacks_v1",
      "kind": "transport_compatibility_patch",
      "upstream_symbol": "decomp.models.gpt3generator.GPT3Generator.generate_text_sequence",
      "changes": [
        "explicitly select a caller-bound raw-completion backend instead of the legacy engine and disk response cache",
        "retain all native participant prompts, branch scoring, answer parsing, task routing and best-first control flow",
        "preserve native sampling, stop and output caps; bound total calls and actual generated tokens before dispatch",
        "require exact source, worker, dependency-version and import-origin attestation before completions",
        "isolate native cache HOME per worker without exposing provider credentials or request-selected URLs",
        "record this as controlled_adapter, not original GPT-3 checkpoint or transport parity"
      ]
    },
    {
      "id": "bounded_best_first_trace_v1",
      "upstream_symbol": "decomp.inference.model_search.BestFirstDecomposer.find_answer_decomp",
      "kind": "control_flow_preserving_compatibility_patch",
      "changes": [
        "bound controller.execute invocations by request.max_steps",
        "record deterministic frontier pops and state transitions",
        "return an explicit termination reason"
      ]
    },
    {
      "id": "bounded_generator_steps_v1",
      "upstream_symbol": "decomp.inference.configurable_inference.build_decomposer_and_models",
      "kind": "configuration_compatibility_patch",
      "changes": [
        "cap upstream question-generator max_steps by request.max_steps",
        "deep-copy config before upstream builder mutation"
      ]
    },
    {
      "id": "context_identity_passthrough_v2",
      "upstream_symbol": "decomp.inference.configurable_inference.inference_mode",
      "kind": "input_contract_compatibility_patch",
      "changes": [
        "pass request paragraphs through upstream example.paras without rewriting their text",
        "bind ordered paragraph IDs and texts to a request context hash",
        "echo paragraph IDs and context hash for core-side identity validation"
      ]
    },
    {
      "id": "safe_jsonnet_and_model_gate_v1",
      "upstream_symbol": "decomp.inference.configurable_inference.load_config",
      "kind": "security_patch",
      "changes": [
        "resolve config only through a checksum-locked logical artifact ID",
        "provide only manifest-pinned Jsonnet extVars",
        "reject ExprEvalQAParticipantModel because it executes Python eval",
        "never expose a request-controlled path, module, callable, host, or command"
      ]
    }
  ]
